        filtered=shelf.b0*x+b[410];
        b[410]=shelf.b1*x-shelf.a1*filtered+b[411];
        b[411]=shelf.b2*x-shelf.a2*filtered;
        weighted=hp.b0*filtered+b[412];
        b[412]=hp.b1*filtered-hp.a1*weighted+b[413];
        b[413]=hp.b2*filtered-hp.a2*weighted;
        power+=WEIGHTS[ch]*weighted*weighted;
      );
    );
    ch+=1;
  );
  // Each measured pair's sample product joins its current 5 ms slice.
  pair=0;
  loop(pair_used,
    PAIR_BASE[PAIR_LIST[pair]*PAIR_STRIDE+80]+=PAIR_SAMPLES[PAIR_A[pair]]*PAIR_SAMPLES[PAIR_B[pair]];
    pair+=1;
  );
  // Invalid audio must remain a failure even when only basic meters are available.
  is_playing && !sample_valid ? lra_error();
  is_playing && rate_ok && lra_valid!=-1 ? (
    !(power>=0 && power<=power_limit) ? lra_error() : (
      crest_energy+=sample_energy/channel_count;
      crest_samples+=1;
      crest_peak=max(crest_peak,sample_peak);
      lra_samples+=1;
      slice_count+=1; live_slice_count+=1;
      layout_known ? (
        slice_power+=power; live_slice_power+=power;
        history_due=live_slice_count>=live_slice_length;
        history_due ? live_loudness_slice();
        slice_count>=slice_length ? lra_slice();
        history_due ? history_publish();
      ) : live_slice_count>=live_slice_length ? (
        live_slice_count=0; slice_count=0;
        // Unknown speaker roles withhold loudness while preserving the audio clock.
        live_publish(-150,-150);
      );
    );
  );
  meter_samples+=1;
  count+=1;
  count>=block_length ? (
    lra_revision=(lra_revision+1)%1000000000;
    filled=min(80,filled+1);
    ch=0;
    loop(channel_count,
      b=CHANNEL_BASE+ch*CHANNEL_STRIDE;
      b[slot]=b[400]; b[80+slot]=b[401]; b[160+slot]=b[402];
      b[240+slot]=b[403]; b[320+slot]=b[404];
      energy=p=tp=0; p_sample=tp_sample=0; k=0;
      loop(filled,
        energy+=b[k];
        b[80+k]>p ? (p=b[80+k]; p_sample=b[160+k];)
          : b[80+k]==p ? p_sample=max(p_sample,b[160+k]);
        b[240+k]>tp ? (tp=b[240+k]; tp_sample=b[320+k];)
          : b[240+k]==tp ? tp_sample=max(tp_sample,b[320+k]);
        k+=1;
      );
      b[450]=p_sample; b[451]=tp_sample; b[452]=p; b[453]=tp;
      b[441]=p>0 ? db_per_log*log(p) : -150;
      b[442]=p>0 ? (meter_samples-p_sample)/srate : 0;
      b[444]=tp>0 ? db_per_log*log(tp) : -150;
      b[445]=tp>0 ? (meter_samples-tp_sample)/srate : 0;
      b[449]=energy;
      b[448]=energy>0 ? db_per_log*.5*log(energy/(block_length*filled)) : -150;
      filled==80 ? (
        b[440]=energy>0 ? db_per_log*0.5*log(energy/(block_length*80)) : -150;
        b[447]=energy>0 ? max(0,b[441]-b[440]) : -1;
      );
      b[443]=b[405]>0 ? max(-150,db_per_log*log(b[405])) : -150;
      b[446]=b[406]>0 ? max(-150,db_per_log*log(b[406])) : -150;
      b[400]=b[401]=b[403]=0;
      ch+=1;
    );
    pair_window(0);
    slot=(slot+1)%80;
    channel_aliases();
    true_peak_max=tp_max>0 ? db_per_log*log(tp_max) : -150;
    update_crest();
    sequence=(sequence+1)%1000000000;
    channel_publish();
    lra_revision=(lra_revision+1)%1000000000;
    sliderchange(136314879);
    sliderchange(slider29); sliderchange(slider30);
    sliderchange(slider31); sliderchange(slider32);
    sliderchange(slider33); sliderchange(slider34);
    sliderchange(slider35);
    count=0;
  );
);
vm_ready ? vm_frame+=1;
