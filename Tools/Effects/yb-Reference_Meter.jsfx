@init
ext_noinit=1;
ext_nodenorm=1;
function valid_number(x) (x == x && x >= 0 && x <= 1000000000);
function valid_counter(x) (valid_number(x) && x >= 0 && x < 1000000000 && x == floor(x));
HISTORY_BASE=150000;
HISTORY_DATA=150032;
HISTORY_CAPACITY=1000;
CHANNEL_BASE=40000;
CHANNEL_STRIDE=1024;
WEIGHTS=49000;
NEXT_WEIGHTS=49016;
OUTPUTS=49032;
NEXT_OUTPUTS=49048;
ch=0; loop(8, OUTPUTS[ch]=ch; ch+=1;);
max_output=2;
CHANNEL_PACKET=156000;
// Pair correlation for the Surround Field. Each channel pair sums its sample
// products over the same 80 slices as the field RMS, so the two can be divided
// directly. Pairs follow (1,2), (1,3) ... (1,n), (2,3) ...; eight channels make 28.
PAIR_PACKET=156100;
PAIR_BASE=50000;
// Per pair: [0..79] slice ring, [80] current slice, [81] window sum, [82] correlation.
PAIR_STRIDE=96;
PAIR_SAMPLES=52800;
// The controller names the pairs its display draws as a bit mask (bit p for
// pair p). Only those pairs are measured; the rest publish -2. A controller
// that predates the mask never writes its slot; the current one clears it on close.
PAIR_LIST=52816; PAIR_A=52848; PAIR_B=52880;
pair_mask=0; pair_used=0;
channel_count=2;
layout_known=1;
layout_revision=0;
WEIGHTS[0]=WEIGHTS[1]=1;
// The fixed channel packet shares the slider publication guard and has its own
// seal, so a controller can reject a partial packet without accepting old lanes.
function channel_publish() local(ch b row p) (
  accepted_session>0 && gmem[140004]==owned_token && gmem[140002]==accepted_session ? (
    gmem[CHANNEL_PACKET+8]=lra_revision;
    gmem[CHANNEL_PACKET]=4;
    gmem[CHANNEL_PACKET+1]=owned_token;
    gmem[CHANNEL_PACKET+2]=accepted_session;
    gmem[CHANNEL_PACKET+3]=capture_epoch;
    gmem[CHANNEL_PACKET+4]=sequence;
    gmem[CHANNEL_PACKET+5]=channel_count;
    gmem[CHANNEL_PACKET+6]=layout_known;
    gmem[CHANNEL_PACKET+7]=layout_revision;
    gmem[CHANNEL_PACKET+9]=measurement_inputs;
    ch=0;
    loop(channel_count,
      b=CHANNEL_BASE+ch*CHANNEL_STRIDE;
      row=CHANNEL_PACKET+16+ch*9;
      gmem[row]=b[440]; gmem[row+1]=b[441];
      gmem[row+2]=b[442]; gmem[row+3]=b[443];
      gmem[row+4]=b[444]; gmem[row+5]=b[445];
      gmem[row+6]=b[446]; gmem[row+7]=b[447];
      gmem[row+8]=b[448];
      ch+=1;
    );
    // Written inside the channel packet's seal, so a reader takes both or neither.
    // Older controllers never read these slots; older helpers never write them.
    gmem[PAIR_PACKET]=1;
    gmem[PAIR_PACKET+1]=owned_token;
    gmem[PAIR_PACKET+2]=accepted_session;
    gmem[PAIR_PACKET+3]=sequence;
    gmem[PAIR_PACKET+4]=channel_count;
    p=0;
    loop(channel_count*(channel_count-1)/2,
      gmem[PAIR_PACKET+8+p]=PAIR_BASE[p*PAIR_STRIDE+82];
      p+=1;
    );
    gmem[CHANNEL_PACKET+8]=(lra_revision+1)%1000000000;
  );
);
function channel_aliases() local(b) (
  b=CHANNEL_BASE;
  rms_l=b[440]; peak_l=b[441]; peak_age_l=b[442]; live_peak_l=b[443];
  true_peak_l=b[444]; true_peak_age_l=b[445]; live_true_peak_l=b[446]; crest_l=b[447];
  b=CHANNEL_BASE+CHANNEL_STRIDE;
  rms_r=b[440]; peak_r=b[441]; peak_age_r=b[442]; live_peak_r=b[443];
  true_peak_r=b[444]; true_peak_age_r=b[445]; live_true_peak_r=b[446]; crest_r=b[447];
);
function pair_select() local(i j p) (
  pair_used=0; p=0; i=0;
  loop(channel_count-1,
    j=i+1;
    loop(channel_count-1-i,
      pair_mask & (1<<p) ? (
        PAIR_LIST[pair_used]=p; PAIR_A[pair_used]=i; PAIR_B[pair_used]=j;
        pair_used+=1;
      );
      j+=1; p+=1;
    );
    i+=1;
  );
);
// Runs after the channel energies are current. A completed slice enters the
// ring; a final partial slice is added without entering it, matching the field RMS.
// -2 marks a pair with a silent channel, which has no correlation. Pairs the
// controller did not request keep the -2 written by the window reset.
function pair_window(partial) local(n q k sum ea eb ba bb) (
  n=0;
  loop(pair_used,
    q=PAIR_BASE+PAIR_LIST[n]*PAIR_STRIDE;
    ba=CHANNEL_BASE+PAIR_A[n]*CHANNEL_STRIDE; bb=CHANNEL_BASE+PAIR_B[n]*CHANNEL_STRIDE;
    partial ? (
      sum=q[81]+q[80]; ea=ba[449]+ba[400]; eb=bb[449]+bb[400];
      filled==80 ? (sum-=q[slot]; ea-=ba[slot]; eb-=bb[slot];);
    ) : (
      q[slot]=q[80]; q[80]=0;
      sum=0; k=0; loop(filled, sum+=q[k]; k+=1;);
      q[81]=sum; ea=ba[449]; eb=bb[449];
    );
    q[82]=ea>0 && eb>0 ? max(-1,min(1,sum/sqrt(ea*eb))) : -2;
    n+=1;
  );
);
// Only the addressed owner publishes here. Unclaimed Monitor FX instances must
// not erase another instance's history when REAPER initializes them.
function history_owned() (
  accepted_session>0 && gmem[140004]==owned_token
    && gmem[140002]==accepted_session;
);
function history_header() (
  gmem[HISTORY_BASE]=2;
  gmem[HISTORY_BASE+1]=owned_token;
  gmem[HISTORY_BASE+2]=accepted_session;
  gmem[HISTORY_BASE+3]=capture_epoch;
  gmem[HISTORY_BASE+4]=history_sequence;
  gmem[HISTORY_BASE+5]=momentary_max;
  gmem[HISTORY_BASE+6]=short_term_max;
  gmem[HISTORY_BASE+7]=HISTORY_CAPACITY;
);
function history_publish() local(address) (
  history_owned() ? (
    lra_revision=(lra_revision+1)%1000000000;
    momentary_max=max(momentary_max,live_m);
    short_term_max=max(short_term_max,live_s);
    history_sequence+=1;
    address=HISTORY_DATA+((history_sequence-1)%HISTORY_CAPACITY)*5;
    gmem[address]=-history_sequence;
    gmem[address+1]=lra_samples/srate;
    gmem[address+2]=live_m;
    gmem[address+3]=live_s;
    gmem[address+4]=integrated;
    gmem[address]=history_sequence;
    history_header();
    lra_revision=(lra_revision+1)%1000000000;
  );
);
// The 48 kHz coefficients are from ITU-R BS.1770-5. An inverse bilinear map
// followed by the target-rate bilinear map preserves them exactly at 48 kHz.
function map_coeffs(src_b0 src_b1 src_b2 src_a1 src_a2 ratio)
  instance(b0 b1 b2 a1 a2)
  local(bc bs bq ac as aq r2 norm)
(
  bc=src_b0+src_b1+src_b2; bs=2*(src_b0-src_b2);
  bq=src_b0-src_b1+src_b2;
  ac=1+src_a1+src_a2; as=2*(1-src_a2); aq=1-src_a1+src_a2;
  r2=ratio*ratio;
  norm=ac+as*ratio+aq*r2;
  this.b0=(bc+bs*ratio+bq*r2)/norm;
  this.b1=(2*bc-2*bq*r2)/norm;
  this.b2=(bc-bs*ratio+bq*r2)/norm;
  this.a1=(2*ac-2*aq*r2)/norm;
  this.a2=(ac-as*ratio+aq*r2)/norm;
);
function biquad(x b0 b1 b2 a1 a2)
  instance(z1 z2)
  local(y)
(
  y=b0*x+z1;
  z1=b1*x-a1*y+z2;
  z2=b2*x-a2*y;
  y;
);
// ITU-R BS.1770-5 Annex 2 four-phase FIR: 12 samples per phase.
// Doubled history and fixed taps keep reconstruction cheap at high rates.
function true_peak_sample(x history_base)
  local(sample_index h0 h1 h2 h3 h4 h5 h6 h7 h8 h9 h10 h11
    phase0 phase1 phase2 phase3)
(
  (history_base+tp_head)[0]=x;
  (history_base+tp_head+12)[0]=x;
  sample_index=history_base+tp_head+1;
  h0=(sample_index+0)[0];
  h1=(sample_index+1)[0];
  h2=(sample_index+2)[0];
  h3=(sample_index+3)[0];
  h4=(sample_index+4)[0];
  h5=(sample_index+5)[0];
  h6=(sample_index+6)[0];
  h7=(sample_index+7)[0];
  h8=(sample_index+8)[0];
  h9=(sample_index+9)[0];
  h10=(sample_index+10)[0];
  h11=(sample_index+11)[0];
  // Fixed taps and cached samples avoid repeated address work at each phase.
  phase0=0.001708984375*h0+0.010986328125*h1+-0.0196533203125*h2
    +0.033203125*h3+-0.0594482421875*h4+0.1373291015625*h5
    +0.97216796875*h6+-0.102294921875*h7+0.047607421875*h8
    +-0.026611328125*h9+0.014892578125*h10+-0.00830078125*h11;
  phase1=-0.0291748046875*h0+0.029296875*h1+-0.0517578125*h2
    +0.089111328125*h3+-0.16650390625*h4+0.465087890625*h5
    +0.77978515625*h6+-0.2003173828125*h7+0.1015625*h8
    +-0.0582275390625*h9+0.0330810546875*h10+-0.0189208984375*h11;
  phase2=-0.0189208984375*h0+0.0330810546875*h1+-0.0582275390625*h2
    +0.1015625*h3+-0.2003173828125*h4+0.77978515625*h5
    +0.465087890625*h6+-0.16650390625*h7+0.089111328125*h8
    +-0.0517578125*h9+0.029296875*h10+-0.0291748046875*h11;
  phase3=-0.00830078125*h0+0.014892578125*h1+-0.026611328125*h2
    +0.047607421875*h3+-0.102294921875*h4+0.97216796875*h5
    +0.1373291015625*h6+-0.0594482421875*h7+0.033203125*h8
    +-0.0196533203125*h9+0.010986328125*h10+0.001708984375*h11;
  max(abs(x),max(max(abs(phase0),abs(phase1)),max(abs(phase2),abs(phase3))));
);
function lra_publish(new_value new_low new_high new_valid new_seconds) (
  lra_revision=(lra_revision+1)%1000000000;
  lra=new_value; lra_low=new_low; lra_high=new_high;
  lra_valid=new_valid; lra_seconds=new_seconds;
  lra_revision=(lra_revision+1)%1000000000;
);
function clear_loudness(new_valid new_seconds) (
  live_m=live_s=integrated=-150;
  crest=-1;
  lra=0; lra_low=lra_high=-150;
  lra_valid=new_valid; lra_seconds=new_seconds;
);
function lra_reset_publish(new_valid new_seconds) (
  lra_revision=(lra_revision+1)%1000000000;
  clear_loudness(new_valid,new_seconds);
  lra_revision=(lra_revision+1)%1000000000;
);
function lra_error() (
  lra_valid != -1 ? lra_reset_publish(-1,lra_samples/srate);
);
function live_publish(new_m new_s) (
  lra_revision=(lra_revision+1)%1000000000;
  live_m=new_m; live_s=new_s;
  // The display clock follows live audio, independently of the 100 ms LRA census.
  lra_seconds=lra_samples/srate;
  lra_revision=(lra_revision+1)%1000000000;
);
function live_loudness_slice()
  local(i momentary_power short_power new_m new_s)
(
  (13000+live_slot)[0]=live_slice_power;
  live_slot=(live_slot+1)%300;
  live_slice_power=0; live_slice_count=0;
  // Re-summing the fixed ring avoids cancellation after a loud passage fades.
  i=0; momentary_power=0; short_power=0;
  loop(300,
    short_power+=(13000+i)[0];
    i+=1;
  );
  i=(live_slot+260)%300;
  loop(40,
    momentary_power+=(13000+i)[0];
    i=(i+1)%300;
  );
  new_m=momentary_power>0 ? max(-150,-0.691+10/log(10)*log(momentary_power/(srate*0.4))) : -150;
  new_s=short_power>0 ? max(-150,-0.691+10/log(10)*log(short_power/(srate*3))) : -150;
  live_publish(new_m,new_s);
);
function lra_update()
  local(i level rank_low rank_high selected total gated low high threshold)
(
  // Below 20 gated observations, a percentile range is too easy to mistake
  // for a settled programme statistic.
  abs_count >= 20 ? (
    threshold=-0.691+10/log(10)*log(abs_power_sum/abs_count)-20;
    i=hist_min; total=0;
    loop(hist_max-hist_min+1,
      level=-70+i*0.01;
      level >= threshold ? total+= (512+i)[0];
      i+=1;
    );
    total >= 20 ? (
      rank_low=floor((total-1)*0.10+1.5);
      rank_high=floor((total-1)*0.95+1.5);
      i=hist_min; selected=0; low=-150; high=-150;
      loop(hist_max-hist_min+1,
        level=-70+i*0.01;
        level >= threshold ? (
          selected+=(512+i)[0];
          low == -150 && selected >= rank_low ? low=level;
          high == -150 && selected >= rank_high ? high=level;
        );
        i+=1;
      );
      lra_publish(max(0,high-low),low,high,1,lra_samples/srate);
    ) : lra_publish(0,-150,-150,0,lra_samples/srate);
  ) : lra_publish(0,-150,-150,0,lra_samples/srate);
);
// BS.1770 programme gating: complete 400 ms blocks, 75% overlap,
// an absolute -70 LUFS gate, then a relative gate 10 LU below their mean.
// Bins retain actual power sums; only the gate boundary is quantized (0.01 LU).
function integrated_slice()
  local(i power level bin gate count total)
(
  slice_filled >= 4 ? (
