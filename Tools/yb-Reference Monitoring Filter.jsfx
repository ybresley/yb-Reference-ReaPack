      drain_span = max(0, drain_available - drain_start);
      drain_passes = drain_available == FFT_SIZE ? 1 : drain_span > 0
        ? min(5, ceil(max(0, drain_span - 1) / HOP_SIZE) + 1)
        : 0;
      drain_pass = 0;
      frame_ready = 0;
      band = 0;
      loop(DISPLAY_BINS,
        FINAL_LIVE_DB[band] = -180;
        band += 1;
      );
    ) : next_capture_state != 1 && capture_state == 1 ? reset_capture();

    spectrum_epoch = next_epoch;
    spectrum_session = next_session;
    spectrum_srate = srate;
    smoothing_octaves = max(0, min(1, next_smoothing));
    capture_state = next_capture_state;
    average_seconds = next_average_seconds;
    history_epoch = next_history_epoch;
    idle_seconds = next_idle_seconds;
    stereo_enabled = next_stereo_enabled;
    outputs_changed ? (
      clear_scene(0); clear_scene(1);
      activation_position = 0;
    );
    memcpy(OUTPUTS, NEXT_OUTPUTS, MAX_CHANNELS);
    max_output = next_max_output;
    analysis_channels = next_analysis_channels;
    analysis_revision = next_analysis_revision;
    pair_left = next_pair_left - 1;
    pair_right = next_pair_right - 1;
    history_changed ? (
      applied_idle_seconds = idle_seconds;
    ) : (
      idle_delta = max(0, idle_seconds - applied_idle_seconds);
      apply_idle_decay(idle_delta);
      applied_idle_seconds = max(applied_idle_seconds, idle_seconds);
    );
    spectrum_config_revision = spectrum_revision;
    // A complete command may start capture only while this controller is live.
    // Once armed, capture outlives the short lease that keeps filtering safe.
    (spectrum_config_changed || heartbeat_changed) && next_capture_state == 1
        && !capture_session_pending && controller_alive && control_protocol == 15
        ? capture_authorized = 1;

    smoothing_changed && has_publication && same_retiring_epoch
        && !fft_or_rate_changed ? (
      // Smoothing is applied after the FFT, so the most recent unsmoothed
      // bands can update Live immediately without waiting for more audio.
      refresh_smoothed_display();
      publish_snapshot(next_capture_state == 1 ? 0 : 1);
    ) : spectrum_config_changed && has_publication && same_retiring_epoch
        && !fft_or_rate_changed && !smoothing_changed
        && next_capture_state != 1 && !final_requested && !drain_active ? (
      // Publish option/reset changes while idle so a retained sibling history
      // cannot be replaced later by arrays from before the reset.
      publish_snapshot(1);
    );
  );
);
stereo_final_requested && stereo_enabled ? (
  stereo_packet_count > 0 ? publish_stereo(1) : (
    // Exact packet-boundary stops still give the last real packet a final mark.
    stereo_serial > 0 && source_samples > 0 ? (
      last_stereo_slot = STEREO_BASE
        + ((stereo_serial - 1) % STEREO_QUEUE) * STEREO_PACKET_STRIDE;
      gmem[last_stereo_slot + 1] == spectrum_epoch
          && gmem[last_stereo_slot + 2] == spectrum_session
          ? gmem[1094] = stereo_serial;
    );
  );
);
// The block callback can publish one FFT snapshot per audio block. Do not claim
// a smaller hop than the host can actually deliver.
HOP_SIZE = max(FFT_SIZE / 4, samplesblock);


now = time_precise();
stereo_block_started_at = stereo_this_block_at;
stereo_block_start_sample = source_samples;
stereo_block_rate = srate;
// An off command or incompatible controller revokes capture immediately.
(gmem[19] != 1 || gmem[0] != 15 || control_protocol != 15
    || gmem[18] != spectrum_epoch || gmem[25] != spectrum_session)
    ? capture_authorized = 0;
gmem[54] = measurement_inputs;
active = capture_authorized && control_protocol == 15 && capture_state == 1
  && measurement_inputs >= (vm_requested ? analysis_channels : max_output)
  && gmem[19] == 1
  && gmem[18] == spectrum_epoch && gmem[25] == spectrum_session;
gmem[44] = active;
gmem[1093] = active && stereo_enabled;
// A pending final command freezes the real samples for its complete revision.
!active && last_capture_active && !drain_active && gmem[19] != 2
    && !(vm_requested && !vm_ready && !vm_failed) ? reset_capture();
// A temporary raw wait pauses this source without discarding its FFT history.
!(vm_requested && !vm_ready && !vm_failed) ? last_capture_active = active;

// Finalisation is staged one FFT per callback so Detailed mode cannot perform
// five expensive transforms in one real-time block. The source ring is frozen.
drain_active ? (
  drain_passes == 0 ? (
    publish_snapshot(1);
    drain_active = 0;
  ) : (
    // A full ring already has a complete real window. Centring its last sample
    // against padded silence would invent a sharp edge and broadband energy.
    drain_available == FFT_SIZE ? prepare_live_fft() : (
      drain_passes == 1
        ? drain_anchor = max(0, drain_available - 1)
        : drain_anchor = drain_start
          + (drain_available - 1 - drain_start) * drain_pass / (drain_passes - 1);
      prepare_final_fft(drain_anchor, drain_available);
    );
    drain_base_samples = floor(drain_measured_samples / drain_passes);
    drain_remainder = drain_measured_samples - drain_base_samples * drain_passes;
    drain_sample_weight = drain_base_samples + (drain_pass < drain_remainder);
    analyse_prepared_fft(drain_sample_weight);
    band = 0;
    loop(DISPLAY_BINS,
      FINAL_LIVE_DB[band] = max(FINAL_LIVE_DB[band], DISPLAY_DB[band]);
      band += 1;
    );
    drain_pass += 1;
    drain_pass >= drain_passes ? (
      history_samples += drain_measured_samples;
      drain_measured_samples > 0
        ? last_published_peak = power_to_db(sample_peak * sample_peak);
      band = 0;
      loop(DISPLAY_BINS,
        DISPLAY_DB[band] = FINAL_LIVE_DB[band];
        band += 1;
      );
      publish_snapshot(1);
      sample_peak = 0;
      pending_samples = 0;
      drain_active = 0;
    );
  );
) : frame_ready && active ? (
  frame_ready = 0;
  measured_samples = pending_samples;
  prepare_live_fft();
  analyse_prepared_fft(measured_samples);
  history_samples += measured_samples;
  measured_samples > 0 ? last_published_peak = power_to_db(sample_peak * sample_peak);
  publish_snapshot(0);
  capture_frames += 1;
  sample_peak = 0;
  pending_samples = 0;
);


@sample
vm_requested && vm_ready && !vm_identity_current() ? (
  vm_ready=0; vm_force_reset=1; vm_acknowledge(0,1); active=0; gmem[44]=0; gmem[1093]=0;
);

// Capture every active input before any monitoring filter writes spl().
active ? (
capture_channel = 0;
loop(analysis_channels,
  capture_ring = RING_BASE + capture_channel * RING_STRIDE;
  capture_sample=vm_requested ? VM_P[vm_frame*8+capture_channel] : spl(OUTPUTS[capture_channel]);
  capture_ring[write_pos] = capture_sample;
  sample_peak = max(sample_peak, abs(capture_sample));
  capture_channel += 1;
);

write_pos = (write_pos + 1) % FFT_SIZE;
samples_filled = min(FFT_SIZE, samples_filled + 1);
source_samples += 1;
stereo_enabled ? (
  stereo_packet_count == 0 ? begin_stereo_packet();
  capture_l = vm_requested ? VM_P[vm_frame*8+pair_left] : spl(OUTPUTS[pair_left]);
  capture_r = vm_requested ? VM_P[vm_frame*8+pair_right] : spl(OUTPUTS[pair_right]);
  gmem[stereo_packet_start + 16 + stereo_packet_count] = capture_l;
  gmem[stereo_packet_start + 16 + STEREO_POINTS + stereo_packet_count] = capture_r;
  stereo_packet_count += 1;
  (abs(capture_l) >= 1 || abs(capture_r) >= 1) ? (
    stereo_clip_total += 1;
    stereo_last_clip_l = capture_l;
    stereo_last_clip_r = capture_r;
    stereo_last_clip_at = stereo_block_started_at
      + (source_samples - stereo_block_start_sample) / srate;
    stereo_last_clip_sample = source_samples;
  );
  stereo_packet_count >= stereo_packet_samples ? (
    stereo_last_sample_at = stereo_block_started_at
      + (source_samples - stereo_block_start_sample) / srate;
    publish_stereo(0);
  );
);
pending_samples += 1;
since_hop += 1;
since_hop >= HOP_SIZE ? (
  since_hop -= HOP_SIZE;
  samples_filled >= FFT_SIZE ? (
    frame_ready = 1;
  );
);

);


vm_ready ? vm_frame+=1;
filtering_now ? (
  activation_blend = smoothstep(min(1, activation_position));
  transition_blend = transition_phase == 2
    ? smoothstep(min(1, transition_position))
    : 0;
  transition_equal_power && transition_phase == 2 ? (
    old_gain = cos(transition_blend * $pi * 0.5);
    new_gain = sin(transition_blend * $pi * 0.5);
  ) : (
    old_gain = 1 - transition_blend;
    new_gain = transition_blend;
  );

  channel = 0;
  channels_to_process = num_ch >= max_output ? analysis_channels : 0;
  loop(channels_to_process,
    dry_sample = spl(OUTPUTS[channel]);
    filtered_sample = process_scene(dry_sample, active_scene, channel);
    transition_phase > 0 ? (
      target_sample = process_scene(dry_sample, fade_to, channel);
      transition_phase == 2 ? (
        filtered_sample = filtered_sample * old_gain + target_sample * new_gain;
      );
    );
    spl(OUTPUTS[channel]) = dry_sample
      + (filtered_sample - dry_sample) * activation_blend;
    channel += 1;
  );

  activation_position = min(1, activation_position + activation_step);
  transition_phase == 1 ? (
    warmup_position = min(1, warmup_position + warmup_step);
    warmup_position >= 1 ? (
      transition_phase = 2;
      transition_position = 0;
    );
  ) : transition_phase == 2 ? (
    transition_position = min(1, transition_position + transition_step);
    transition_position >= 1 ? (
      active_scene = fade_to;
      transition_phase = 0;
    );
  );
) : (
  // Leaving spl() untouched is REAPER's exact pass-through path. Inactive,
  // expired states must never depend on filtered samples.
  activation_position = 0;
);
