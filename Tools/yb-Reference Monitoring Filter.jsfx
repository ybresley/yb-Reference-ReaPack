@init

ext_noinit = 1;

FILTER_COEFF = 0;
COEFF_SCENE_STRIDE = 40;
FILTER_STATE = 128;
STATE_SCENE_STRIDE = 128;
SCENE_STAGES = 400;
SCENE_LOW = 404;
SCENE_HIGH = 408;
SCENE_SLOPE = 412;
BIQUADS_PER_SCENE = 8;
COEFFS_PER_BIQUAD = 5;
MAX_CHANNELS = 8;
OUTPUTS = 448;
NEXT_OUTPUTS = 464;
output_init = 0; loop(8, OUTPUTS[output_init] = output_init; output_init += 1;);
max_output = 2;
LEASE_TIMEOUT = 0.75;
ACTIVATION_FADE_SECONDS = 0.020;
CONFIG_FADE_SECONDS = 0.040;
BAND_WARMUP_SECONDS = 0.025;

function clear_scene(scene) local(i, state_base)
(
  state_base = FILTER_STATE + scene * STATE_SCENE_STRIDE;
  i = 0;
  loop(STATE_SCENE_STRIDE,
    state_base[i] = 0;
    i += 1;
  );
);

// kind: 0 = high-pass, 1 = low-pass. Coefficients use the standard
// bilinear-transform biquad form, normalised by a0.
function set_filter_coeff(scene, biquad, kind, frequency, q)
  local(w0, cosine, sine, alpha, a0, base)
(
  w0 = 2 * $pi * frequency / srate;
  cosine = cos(w0);
  sine = sin(w0);
  alpha = sine / (2 * q);
  a0 = 1 + alpha;
  base = FILTER_COEFF + scene * COEFF_SCENE_STRIDE
    + biquad * COEFFS_PER_BIQUAD;

  kind == 1 ? (
    base[0] = (1 - cosine) * 0.5 / a0;
    base[1] = (1 - cosine) / a0;
    base[2] = base[0];
  ) : (
    base[0] = (1 + cosine) * 0.5 / a0;
    base[1] = -(1 + cosine) / a0;
    base[2] = base[0];
  );
  base[3] = -2 * cosine / a0;
  base[4] = (1 - alpha) / a0;
);

function configure_scene(scene, lower, upper, slope)
  local(stage, stages, order, q)
(
  stages = slope + 1;
  order = stages * 2;
  stage = 0;
  loop(stages,
    q = 1 / (2 * cos($pi * (2 * (stage + 1) - 1) / (2 * order)));
    set_filter_coeff(scene, stage, 0, lower, q);
    set_filter_coeff(scene, 4 + stage, 1, upper, q);
    stage += 1;
  );
  SCENE_STAGES[scene] = stages;
  SCENE_LOW[scene] = lower;
  SCENE_HIGH[scene] = upper;
  SCENE_SLOPE[scene] = slope;
  clear_scene(scene);
);

function process_biquad(sample, scene, biquad, channel)
  local(coeff, state, output)
(
  coeff = FILTER_COEFF + scene * COEFF_SCENE_STRIDE
    + biquad * COEFFS_PER_BIQUAD;
  state = FILTER_STATE + scene * STATE_SCENE_STRIDE
    + (channel * BIQUADS_PER_SCENE + biquad) * 2;
  output = coeff[0] * sample + state[0];
  state[0] = coeff[1] * sample - coeff[3] * output + state[1];
  state[1] = coeff[2] * sample - coeff[4] * output;
  output;
);

function process_scene(sample, scene, channel)
  local(stage, stages, output)
(
  output = sample;
  stages = SCENE_STAGES[scene];
  stage = 0;
  loop(stages,
    output = process_biquad(output, scene, stage, channel);
    stage += 1;
  );
  stage = 0;
  loop(stages,
    output = process_biquad(output, scene, 4 + stage, channel);
    stage += 1;
  );
  output;
);

function same_config(scene, lower, upper, slope)
(
  abs(SCENE_LOW[scene] - lower) < 0.001
    && abs(SCENE_HIGH[scene] - upper) < 0.001
    && SCENE_SLOPE[scene] == slope;
);

function start_transition(lower, upper, slope)
  local(overlap_low, overlap_high, overlap_width, old_width, new_width,
    overlap_ratio, band_change)
(
  fade_to = 1 - active_scene;
  configure_scene(fade_to, lower, upper, slope);

  band_change = abs(SCENE_LOW[active_scene] - lower) >= 0.001
    || abs(SCENE_HIGH[active_scene] - upper) >= 0.001;
  transition_equal_power = 0;
  band_change ? (
    overlap_low = max(SCENE_LOW[active_scene], lower);
    overlap_high = min(SCENE_HIGH[active_scene], upper);
    overlap_width = overlap_high > overlap_low
      ? log(overlap_high / overlap_low)
      : 0;
    old_width = log(SCENE_HIGH[active_scene] / SCENE_LOW[active_scene]);
    new_width = log(upper / lower);
    overlap_ratio = 2 * overlap_width / max(0.000001, old_width + new_width);
    transition_equal_power = overlap_ratio < 0.5;
  );

  warmup_position = 0;
  transition_position = 0;
  // A changed band begins with an inaudible settling period. A slope-only
  // change reuses the already audible range and can crossfade immediately.
  transition_phase = band_change ? 1 : 2;
);

function smoothstep(value)
(
  value * value * (3 - 2 * value);
);

configure_scene(0, 700, 3000, 1);
active_scene = 0;
fade_to = 1;
transition_phase = 0;
transition_equal_power = 0;
warmup_position = 0;
transition_position = 0;
desired_valid = 0;
accepted_heartbeat = -1;
accepted_revision = -1;
accepted_active = 0;
response_sequence = 0;
control_protocol = 0;
control_heartbeat = -1;
seen_heartbeat = gmem[6];
lease_time = -1000;
activation_position = 0;
last_filtering = 0;
last_srate = srate;

// Spectrum data uses slots 32–1087. Stereo packets occupy 200000–1249599.
// FFT buffers begin after 65536, outside the filter scenes.
MAGIC = 260826.1;
CONTRACT_VERSION = 15;
DATA_OFFSET = 64;
AVERAGE_DATA_OFFSET = 576;
STEREO_BASE = 200000;
STEREO_PACKET_STRIDE = 16400;
STEREO_QUEUE = 64;
STEREO_POINTS = 8192;

DEFAULT_FFT_SIZE = 4096;
DISPLAY_BINS = 512;
MIN_HZ = 10;
MAX_HZ = 22050;

RING_BASE = 262144;
RING_STRIDE = 8192;
FFT_L = 81920;
WINDOW = 114688;
POWER = 122880;
DISPLAY_POWER = 126976;
DISPLAY_DB = 127488;
AVERAGE_POWER = 128000;
FINAL_LIVE_DB = 130560;
LN2 = log(2);
LN10 = log(10);
LN100 = log(100);
FLOOR_POWER = exp(-180 * LN10 / 10);
TONE_CONTRAST_START_DB = 12;
TONE_CONTRAST_FULL_DB = 18;

write_pos = 0;
since_hop = 0;
samples_filled = 0;
frame_ready = 0;
sample_peak = 0;
sequence = 0;
capture_state = 0;
history_epoch = -1;
average_seconds = 0;
average_ready = 0;
average_elapsed_samples = 0;
history_samples = 0;
idle_seconds = 0;
applied_idle_seconds = 0;
source_samples = 0;
pending_samples = 0;
last_published_peak = -180;
last_capture_active = 0;
capture_authorized = 0;
capture_session_pending = 1;
has_publication = 0;
stereo_serial = 0;
stereo_packet_count = 0;
stereo_packet_start = 0;
stereo_packet_samples = 0;
stereo_clip_total = 0;
stereo_last_clip_l = 0;
stereo_last_clip_r = 0;
stereo_last_clip_at = 0;
stereo_last_clip_sample = 0;
stereo_block_started_at = 0;
stereo_block_start_sample = 0;
stereo_block_rate = srate;
stereo_last_sample_at = 0;
stereo_enabled = 0;
analysis_channels = 2;
analysis_revision = -1;
pair_left = 0;
pair_right = 1;

function begin_stereo_packet() local(slot)
(
  slot = stereo_serial % STEREO_QUEUE;
  stereo_packet_start = STEREO_BASE + slot * STEREO_PACKET_STRIDE;
  // The odd seal stays visible while samples are written across callbacks.
  gmem[stereo_packet_start] = (stereo_serial + 1) * 2 - 1;
  // The next packet preserves evidence of clips in packets later overwritten.
  gmem[stereo_packet_start + 9] = stereo_clip_total;
  gmem[stereo_packet_start + 10] = stereo_last_clip_l;
  gmem[stereo_packet_start + 11] = stereo_last_clip_r;
  gmem[stereo_packet_start + 12] = stereo_last_clip_at;
  gmem[stereo_packet_start + 13] = stereo_last_clip_sample;
  gmem[stereo_packet_start + 14] = srate;
  stereo_packet_count = 0;
);

function publish_stereo(final_marker)
(
  stereo_packet_count > 0 ? (
    gmem[stereo_packet_start + 1] = spectrum_epoch;
    gmem[stereo_packet_start + 2] = spectrum_session;
    gmem[stereo_packet_start + 3] = stereo_packet_count;
    gmem[stereo_packet_start + 4] = spectrum_config_revision;
    gmem[stereo_packet_start + 5] = final_marker;
    gmem[stereo_packet_start + 6] = source_samples;
    gmem[stereo_packet_start + 7] = stereo_last_sample_at;
    gmem[stereo_packet_start + 8] = stereo_clip_total;
    gmem[stereo_packet_start] = (stereo_serial + 1) * 2;
    stereo_serial += 1;
    gmem[1095] = stereo_serial;
    gmem[1096] = stereo_clip_total;
    stereo_packet_count = 0;
  );
);

function reset_capture() local(i)
(
  // Half a silent window before the first source sample places the onset near
  // the Hann window centre instead of its zero-valued edge.
  write_pos = FFT_SIZE / 2;
  since_hop = 0;
  samples_filled = FFT_SIZE / 2;
  frame_ready = 0;
  drain_active = 0;
  drain_pass = 0;
  sample_peak = 0;
  source_samples = 0;
  pending_samples = 0;
  capture_frames = 0;
  stereo_packet_count = 0;
  stereo_packet_samples = min(STEREO_POINTS, max(1, ceil(srate / 30)));
  stereo_last_clip_l = 0;
  stereo_last_clip_r = 0;
  stereo_last_clip_at = 0;
  stereo_last_clip_sample = 0;
  i = 0;
  loop(RING_STRIDE * MAX_CHANNELS,
    RING_BASE[i] = 0;
    i += 1;
  );
);

function reset_average() local(i)
(
  average_ready = 0;
  average_elapsed_samples = 0;
  i = 0;
  loop(DISPLAY_BINS,
    AVERAGE_POWER[i] = FLOOR_POWER;
    i += 1;
  );
);

function reset_history()
(
  reset_average();
  history_samples = 0;
);

function configure_fft(next_size) local(window_i, window_value)
(
  FFT_SIZE = next_size;
  HOP_SIZE = FFT_SIZE / 4;
  WINDOW_SUM = 0;
  WINDOW_SQUARE_SUM = 0;

  window_i = 0;
  loop(FFT_SIZE,
    window_value = 0.5 - 0.5 * cos(2 * $pi * window_i / (FFT_SIZE - 1));
    WINDOW[window_i] = window_value;
    WINDOW_SUM += window_value;
    WINDOW_SQUARE_SUM += window_value * window_value;
    window_i += 1;
  );
  WINDOW_ENBW = FFT_SIZE * WINDOW_SQUARE_SUM / (WINDOW_SUM * WINDOW_SUM);
  reset_capture();
);

configure_fft(DEFAULT_FFT_SIZE);
reset_history();
i = 0;
loop(DISPLAY_BINS,
  DISPLAY_DB[i] = -180;
  i += 1;
);

gmem[32] = MAGIC;
gmem[33] = CONTRACT_VERSION;
gmem[34] = 0;
gmem[1095] = 0;
gmem[1096] = 0;
gmem[1093] = 0;
gmem[1094] = 0;
gmem[35] = srate;
gmem[36] = DISPLAY_BINS;
gmem[44] = 0;
gmem[40] = MIN_HZ;
gmem[41] = min(MAX_HZ, srate * 0.5);
gmem[42] = FFT_SIZE;
gmem[43] = HOP_SIZE;
spectrum_epoch = -1;
spectrum_session = -1;
spectrum_srate = srate;
spectrum_config_revision = -1;
smoothing_octaves = 1 / 12;

function power_to_db(power)
(
  power <= 0.000000000000000001
    ? -180
    : max(-180, min(36, 10 * log(power) / LN10));
);

// Bounded cubic interpolation fills the space between real FFT measurements
// without creating peaks outside the neighbouring values.
function interpolated_power(position) local(left, right, p0, p1, p2, p3,
    before, across, after, left_slope, right_slope, t, t2, t3, value)
(
  position = max(1, min(BIN_LIMIT, position));
  position >= BIN_LIMIT ? POWER[BIN_LIMIT] : (
    left = floor(position);
    right = left + 1;
    p0 = POWER[max(1, left - 1)];
    p1 = POWER[left];
    p2 = POWER[right];
    p3 = POWER[min(BIN_LIMIT, right + 1)];
    before = p1 - p0;
    across = p2 - p1;
    after = p3 - p2;
    left_slope = before * across <= 0 ? 0 : 2 * before * across / (before + across);
    right_slope = across * after <= 0 ? 0 : 2 * across * after / (across + after);
    t = position - left;
    t2 = t * t;
    t3 = t2 * t;
    value = (2 * t3 - 3 * t2 + 1) * p1
      + (t3 - 2 * t2 + t) * left_slope
      + (-2 * t3 + 3 * t2) * p2
      + (t3 - t2) * right_slope;
    max(0, min(max(p1, p2), max(min(p1, p2), value)));
  );
);

function band_mean_power(lower_hz, upper_hz, center_hz) local(first_bin,
    last_bin, fft_bin, bin_lower_hz, bin_upper_hz, overlap_hz,
    weighted_power, covered_hz)
(
  // Interpolation avoids repeated bass values where a display cell is narrower
  // than one raw FFT interval.
  upper_hz - lower_hz < BIN_HZ
    ? interpolated_power(center_hz / BIN_HZ)
    : (
      first_bin = max(1, ceil(lower_hz / BIN_HZ - 0.5));
      last_bin = min(BIN_LIMIT, floor(upper_hz / BIN_HZ + 0.5));
      fft_bin = first_bin;
      weighted_power = 0;
      covered_hz = 0;
      loop(max(0, last_bin - first_bin + 1),
        bin_lower_hz = max(lower_hz, (fft_bin - 0.5) * BIN_HZ);
        bin_upper_hz = min(upper_hz, (fft_bin + 0.5) * BIN_HZ);
        overlap_hz = max(0, bin_upper_hz - bin_lower_hz);
        weighted_power += POWER[fft_bin] * overlap_hz;
        covered_hz += overlap_hz;
        fft_bin += 1;
      );
      covered_hz > 0
        ? weighted_power / covered_hz
        : interpolated_power(center_hz / BIN_HZ);
    );
);

function tone_cluster_power(fft_bin) local(first_bin, last_bin, source_bin,
    cluster_power)
(
  first_bin = max(1, fft_bin - 1);
  last_bin = min(BIN_LIMIT, fft_bin + 1);
  source_bin = first_bin;
  cluster_power = 0;
  loop(last_bin - first_bin + 1,
    cluster_power += POWER[source_bin];
    source_bin += 1;
  );
  cluster_power / WINDOW_ENBW;
);

function tone_background_power(fft_bin) local(offset, source_bin,
    background_power, background_count)
(
  background_power = 0;
  background_count = 0;
  offset = -4;
  loop(3,
    source_bin = fft_bin + offset;
    source_bin >= 1 && source_bin <= BIN_LIMIT ? (
      background_power += POWER[source_bin];
      background_count += 1;
    );
    offset += 1;
  );
  offset = 2;
  loop(3,
    source_bin = fft_bin + offset;
    source_bin >= 1 && source_bin <= BIN_LIMIT ? (
      background_power += POWER[source_bin];
      background_count += 1;
    );
    offset += 1;
  );
  background_count > 0 ? background_power / background_count : 0;
);

function smoothstep01(value)
(
  value = max(0, min(1, value));
  value * value * (3 - 2 * value);
);

// Average broadband energy across each logarithmic cell so wider treble cells
// do not rise simply because they contain more random peaks. A clearly
// concentrated three-bin Hann cluster is restored to its calibrated tone level.
function band_display_power(lower_hz, upper_hz, center_hz) local(first_bin,
    last_bin, fft_bin, baseline_power, display_power, cluster_power,
    background_power, contrast_db, tone_weight, candidate_power)
(
  baseline_power = band_mean_power(lower_hz, upper_hz, center_hz);
  display_power = baseline_power;
  first_bin = max(1, ceil(lower_hz / BIN_HZ));
  last_bin = min(BIN_LIMIT, floor(upper_hz / BIN_HZ));
  fft_bin = first_bin;
  loop(max(0, last_bin - first_bin + 1),
    cluster_power = tone_cluster_power(fft_bin);
    background_power = tone_background_power(fft_bin);
    contrast_db = cluster_power > 0 ? 180 : 0;
    background_power > 0.000000000000000000000000000001 ? (
      contrast_db = 10 * log(cluster_power / background_power) / LN10;
    );
    tone_weight = smoothstep01((contrast_db - TONE_CONTRAST_START_DB)
      / (TONE_CONTRAST_FULL_DB - TONE_CONTRAST_START_DB));
    candidate_power = baseline_power
      + (cluster_power - baseline_power) * tone_weight;
    display_power = max(display_power, candidate_power);
    fft_bin += 1;
  );
  display_power;
);

// Integral of a unit-height triangular kernel from its centre to x. Integrating
// over each finite display cell keeps octave smoothing consistent from bass to
// treble, including 1/24 octave widths that are close to one display cell.
function triangle_integral(x, half_width)
(
  x <= -half_width ? -half_width * 0.5 :
  x < 0 ? x + x * x / (2 * half_width) :
  x < half_width ? x - x * x / (2 * half_width) :
  half_width * 0.5;
);

function smoothed_display_power(index, width_octaves, step_octaves) local(
    half_width, first_band, last_band, source_band, distance,
    lower_distance, upper_distance, weight, weighted_power, weight_total)
(
  width_octaves <= 0 ? DISPLAY_POWER[index] : (
    half_width = width_octaves * 0.5;
    first_band = max(0, ceil(index - half_width / step_octaves - 0.5));
    last_band = min(DISPLAY_BINS - 1,
      floor(index + half_width / step_octaves + 0.5));
    source_band = first_band;
    weighted_power = 0;
    weight_total = 0;
    loop(max(0, last_band - first_band + 1),
      distance = (source_band - index) * step_octaves;
      lower_distance = distance - step_octaves * 0.5;
      upper_distance = distance + step_octaves * 0.5;
      weight = triangle_integral(upper_distance, half_width)
        - triangle_integral(lower_distance, half_width);
      weight > 0 ? (
        weighted_power += DISPLAY_POWER[source_band] * weight;
        weight_total += weight;
      );
      source_band += 1;
    );
    weight_total > 0 ? weighted_power / weight_total : DISPLAY_POWER[index];
  );
);

function refresh_smoothed_display() local(band, step_octaves)
(
  step_octaves = log(min(MAX_HZ, srate * 0.5) / MIN_HZ) / LN2 / DISPLAY_BINS;
  band = 0;
  loop(DISPLAY_BINS,
    DISPLAY_DB[band] = power_to_db(smoothed_display_power(
      band, smoothing_octaves, step_octaves));
    band += 1;
  );
);

function apply_idle_decay(seconds) local(i, amount)
(
  seconds > 0 && average_ready && average_seconds > 0 ? (
    amount = 1 - exp(-seconds * LN100 / average_seconds);
    i = 0;
    loop(DISPLAY_BINS,
      AVERAGE_POWER[i] += (FLOOR_POWER - AVERAGE_POWER[i]) * amount;
      i += 1;
    );
  );
);

function update_histories(measured_samples) local(i, target_power,
    elapsed, amount, current)
(
  measured_samples > 0 ? (
    average_seconds != 0 ? (
      average_ready ? (
        average_seconds < 0 ? (
          elapsed = average_elapsed_samples + measured_samples;
          amount = measured_samples / max(1, elapsed);
        ) : (
          amount = 1 - exp(-measured_samples / srate * LN100 / average_seconds);
          elapsed = average_elapsed_samples + measured_samples;
        );
        i = 0;
        loop(DISPLAY_BINS,
          target_power = exp(DISPLAY_DB[i] * LN10 / 10);
          current = AVERAGE_POWER[i];
          AVERAGE_POWER[i] = current + (target_power - current) * amount;
          i += 1;
        );
        average_elapsed_samples = elapsed;
      ) : (
        i = 0;
        loop(DISPLAY_BINS,
          AVERAGE_POWER[i] = exp(DISPLAY_DB[i] * LN10 / 10);
          i += 1;
        );
        average_ready = 1;
        average_elapsed_samples = measured_samples;
      );
    );
  );
);

// Retain the window description so every channel uses the same source samples.
function prepare_live_fft()
(
  fft_final = 0;
);

function prepare_final_fft(anchor, available)
(
  fft_final = 1;
  fft_anchor = anchor;
  fft_available = available;
);

function prepare_channel_fft(channel_index) local(i, ring, source_index,
    target_start, target_index)
(
  ring = RING_BASE + channel_index * RING_STRIDE;
  i = 0;
  fft_final ? (
    loop(FFT_SIZE, FFT_L[i] = 0; i += 1;);
    source_index = (write_pos - fft_available + FFT_SIZE) % FFT_SIZE;
    target_start = floor(FFT_SIZE / 2 - fft_anchor);
    i = 0;
    loop(fft_available,
      target_index = target_start + i;
      target_index >= 0 && target_index < FFT_SIZE ? (
        FFT_L[target_index] = ring[source_index] * WINDOW[target_index];
      );
      source_index = (source_index + 1) % FFT_SIZE;
      i += 1;
    );
  ) : (
    loop(FFT_SIZE,
      source_index = (write_pos + i) % FFT_SIZE;
      FFT_L[i] = ring[source_index] * WINDOW[i];
      i += 1;
    );
  );
);

function analyse_prepared_fft(measured_samples) local(measured_max_hz, fft_channel)
(
  // JSFX names ignore case: keep the current rate's limit separate from MAX_HZ.
  measured_max_hz = min(MAX_HZ, srate * 0.5);
  normalise = 1 / WINDOW_SUM;
  normalise_power = normalise * normalise / analysis_channels;
  BIN_LIMIT = FFT_SIZE / 2 - 1;
  BIN_HZ = srate / FFT_SIZE;
  fft_bin = 1;
  loop(BIN_LIMIT, POWER[fft_bin] = 0; fft_bin += 1;);

  // Average channel powers after separate transforms. Summing samples first
  // would cancel opposite-polarity channels and hide real surround energy.
  fft_channel = 0;
  loop(analysis_channels,
    prepare_channel_fft(fft_channel);
    fft_real(FFT_L, FFT_SIZE);
    fft_permute(FFT_L, FFT_SIZE / 2);
    fft_bin = 1;
    loop(BIN_LIMIT,
      offset = fft_bin * 2;
      l_re = FFT_L[offset];
      l_im = FFT_L[offset + 1];
      POWER[fft_bin] += (l_re * l_re + l_im * l_im) * normalise_power;
      fft_bin += 1;
    );
    fft_channel += 1;
  );

  display_step_octaves = log(measured_max_hz / MIN_HZ) / LN2 / DISPLAY_BINS;
  band_ratio = exp(LN2 * display_step_octaves);
  lower_hz = MIN_HZ;
  band = 0;
  loop(DISPLAY_BINS,
    upper_hz = lower_hz * band_ratio;
    center_hz = sqrt(lower_hz * upper_hz);
    DISPLAY_POWER[band] = band_display_power(lower_hz, upper_hz, center_hz);
    lower_hz = upper_hz;
    band += 1;
  );

  refresh_smoothed_display();
  update_histories(measured_samples);
);

function publish_snapshot(final_marker) local(band)
(
  sequence += 1;
  gmem[34] = sequence; // odd means a frame is being written

  band = 0;
  loop(DISPLAY_BINS,
    gmem[DATA_OFFSET + band] = DISPLAY_DB[band];
    gmem[AVERAGE_DATA_OFFSET + band] = power_to_db(AVERAGE_POWER[band]);
    band += 1;
  );

  gmem[32] = MAGIC;
  gmem[33] = CONTRACT_VERSION;
  gmem[35] = srate;
  gmem[36] = DISPLAY_BINS;
  gmem[37] = time_precise();
  gmem[38] = last_published_peak;
  gmem[40] = MIN_HZ;
  gmem[41] = min(MAX_HZ, srate * 0.5);
  gmem[42] = FFT_SIZE;
  gmem[43] = HOP_SIZE;
  gmem[39] = spectrum_epoch;
  gmem[45] = smoothing_octaves;
  gmem[46] = spectrum_config_revision;
  gmem[48] = final_marker;
  gmem[49] = average_ready;
  gmem[51] = history_samples;
  gmem[52] = spectrum_session;
  gmem[53] = analysis_channels;

  sequence += 1;
  gmem[34] = sequence; // even means the frame is complete
  has_publication = 1;
);


// BEGIN VIRTUAL MASTER INPUT v1 (identical transport in both consumers).
VM_B=1400000; VM_P=600000; VM_STRIDE=65552; VM_QUEUE=8; VM_RESERVE=3;
vm_last=0; vm_session=0; vm_token=0; vm_instance=0; vm_width=0; vm_rate=0;
vm_previous_request=0; vm_previous_ready=0; vm_failed=0; vm_ack_serial=0; vm_force_reset=0;
memset(VM_P,0,65536);
function vm_acknowledge(ready_value,error_value) local(k) (
  vm_ack_serial+=2;
  gmem[vm_ack+15]=vm_ack_serial-1;
  gmem[vm_ack]=1; gmem[vm_ack+1]=ready_value;
  k=2; loop(12,gmem[vm_ack+k]=0; k+=1;);
  ready_value || (error_value>=4 && error_value<=9) ? (
    gmem[vm_ack+2]=vm_token; gmem[vm_ack+3]=vm_session;
    gmem[vm_ack+4]=vm_last; gmem[vm_ack+5]=vm_width;
    gmem[vm_ack+6]=vm_rate; gmem[vm_ack+7]=vm_instance;
    gmem[vm_ack+9]=samplesblock; gmem[vm_ack+10]=time_precise();
    gmem[vm_ack+11]=vm_revision; gmem[vm_ack+12]=vm_consumer_instance;
    gmem[vm_ack+13]=vm_block_started_at;
  );
  gmem[vm_ack+8]=error_value; gmem[vm_ack+15]=vm_ack_serial;
);
function vm_identity_current() (
  gmem[VM_B+1]==1 && gmem[VM_B+10]==1 && gmem[VM_B+vm_request_slot]==1
    && gmem[VM_B+2]==vm_token && gmem[VM_B+3]==vm_session
    && gmem[VM_B+4]==vm_width && gmem[VM_B+5]==vm_rate
    && gmem[VM_B+9]==vm_instance;
);
function vm_bridge_begin(ack_base,request_slot,consumer_instance)
  local(rev,valid_control,tok,sess,width,rate,inst,latest,wanted,bank,seal,
    age,block_at,fr,ch,pos,copy_ok,error_value,changed_owner,sender_session,sender_error,sender_matches) (
  vm_ack=ack_base; vm_request_slot=request_slot; vm_consumer_instance=consumer_instance;
  vm_requested=gmem[VM_B+request_slot]!=0;
  vm_changed=vm_requested!=vm_previous_request || vm_force_reset; vm_force_reset=0;
  vm_ready=0; vm_frame=0; error_value=0;
  vm_requested ? (
    rev=gmem[VM_B]; tok=gmem[VM_B+2]; sess=gmem[VM_B+3];
    width=gmem[VM_B+4]; rate=gmem[VM_B+5]; inst=gmem[VM_B+9];
    valid_control=rev>=0 && rev==floor(rev) && rev%2==0 && gmem[VM_B+1]==1
      && tok>0 && tok<=999999999 && tok==floor(tok)
      && sess>0 && sess<=999999999 && sess==floor(sess)
      && width>=1 && width<=8 && width==floor(width) && rate==srate
      && inst>0 && inst<=999999999 && inst==floor(inst)
      && gmem[VM_B+10]==1 && gmem[VM_B+request_slot]==1 && rev==gmem[VM_B];
    // A heartbeat can begin or finish during this read. Keep the complete
    // grant only while every identity field still matches; no new lease is earned.
    !valid_control && vm_identity_current() && vm_session>0 && vm_rate==srate ? (
      valid_control=1; tok=vm_token; sess=vm_session; width=vm_width;
      rate=vm_rate; inst=vm_instance; rev=vm_revision;
    );
    valid_control ? (
      changed_owner=tok!=vm_token || sess!=vm_session || width!=vm_width
        || rate!=vm_rate || inst!=vm_instance;
      changed_owner ? (vm_last=0; vm_failed=0; vm_changed=1;);
      vm_token=tok; vm_session=sess; vm_width=width; vm_rate=rate;
      vm_instance=inst; vm_revision=rev;
      sender_session=gmem[VM_B+19]; sender_error=gmem[VM_B+24];
      sender_matches=sender_session==sess && gmem[VM_B+16]==2601104.1 && gmem[VM_B+17]==1
        && gmem[VM_B+20]==tok && gmem[VM_B+21]==width && gmem[VM_B+22]==rate
        && gmem[VM_B+23]==inst && gmem[VM_B+19]==sender_session;
      latest=gmem[VM_B+18];
      !vm_failed && sender_matches && sender_error==0 && gmem[VM_B+27]==1
          && latest>=VM_RESERVE+1 && latest==floor(latest) ? (
        // Leave three complete banks between reader and writer at startup.
        wanted=vm_last>0 ? vm_last+1 : latest-VM_RESERVE;
        latest-wanted>=VM_QUEUE-1 ? (vm_failed=6; error_value=6;) : wanted<=latest ? (
          bank=VM_B+64+((wanted-1)%VM_QUEUE)*VM_STRIDE;
          seal=gmem[bank]; block_at=gmem[bank+7]; age=time_precise()-block_at;
          seal==wanted*2 && gmem[bank+1]==tok && gmem[bank+2]==sess
              && gmem[bank+3]==inst && gmem[bank+4]==width && gmem[bank+5]==rate
              && gmem[bank+6]==samplesblock && samplesblock>=1 && samplesblock<=8192
              && age>=0 && age<=max(.25,4*samplesblock/srate) ? (
            copy_ok=1; fr=0;
            loop(samplesblock,
              ch=0; loop(width,
                pos=bank+16+fr*8+ch;
                !(gmem[pos]>=-1000000 && gmem[pos]<=1000000) ? copy_ok=0;
                VM_P[fr*8+ch]=gmem[pos]; ch+=1;
              ); fr+=1;
            );
            copy_ok && seal==gmem[bank] && vm_identity_current() ? (
              vm_last=wanted; vm_ready=1; vm_block_started_at=block_at;
            ) : (vm_failed=copy_ok ? 4 : 7; error_value=vm_failed;);
          ) : (error_value=gmem[bank+6]!=samplesblock ? 8 : age<0 || age>max(.25,4*samplesblock/srate) ? 5 : 4;);
        ) : (
          error_value=time_precise()-gmem[VM_B+25]>max(.25,4*samplesblock/srate) ? 5 : 3;
        );
      ) : (
        // The sender may still be reporting the grant that stopped.
        error_value=vm_failed ? vm_failed : sender_matches
          && sender_error>=4 && sender_error<=9 && sender_error==floor(sender_error) ? sender_error : 3;
      );
    ) : error_value=2;
    // Waiting never advances the sample clock or erases measured samples. A
    // genuine discontinuity remains visible until a new source generation.
    !vm_ready && error_value!=3 ? (
      !vm_failed ? vm_changed=1;
      vm_failed=error_value;
    );
    vm_acknowledge(vm_ready,error_value);
  ) : (
    vm_previous_request ? vm_acknowledge(0,1);
    vm_last=0; vm_session=0; vm_token=0; vm_failed=0;
  );
  vm_previous_ready=vm_ready; vm_previous_request=vm_requested;
);
// END VIRTUAL MASTER INPUT v1.

vm_ack=VM_B+48; vm_acknowledge(0,1);

@block
vm_bridge_begin(VM_B+48,7,0);
measurement_inputs=vm_requested ? (vm_ready ? vm_width : 0) : num_ch;
vm_changed ? (
  reset_capture(); reset_history(); has_publication=0; capture_authorized=0;
  stereo_serial=0; stereo_clip_total=0;
  gmem[34]=0; gmem[44]=0; gmem[1093]=0; gmem[1094]=0;
  gmem[1095]=0; gmem[1096]=0;
);

source_samples > stereo_block_start_sample && stereo_block_started_at > 0 ? (
  stereo_last_sample_at = stereo_block_started_at
    + (source_samples - stereo_block_start_sample) / stereo_block_rate;
);
stereo_this_block_at = vm_requested && vm_ready ? vm_block_started_at : time_precise();

// Odd/even publication rejects a partial shape without interrupting the last
// accepted filter. Active off remains an immediate, independent dry command.
heartbeat_changed = 0;
control_revision = gmem[9];
control_revision >= 0 && control_revision == floor(control_revision)
    && control_revision % 2 == 0 ? (
  next_protocol = gmem[0];
  next_active = gmem[1];
  next_mode = gmem[2];
  next_low = gmem[3];
  next_high = gmem[4];
  next_slope = gmem[5];
  next_heartbeat = gmem[6];
  control_revision == gmem[9] ? (
    control_protocol = next_protocol;
    control_heartbeat = next_heartbeat;
    accepted_active = next_active;
    heartbeat_changed = control_heartbeat != seen_heartbeat;
    heartbeat_changed ? (
      seen_heartbeat = control_heartbeat;
      lease_time = time_precise();
    );
    control_revision != accepted_revision || srate != last_srate ? (
      accepted_revision = control_revision;
      desired_valid = control_protocol == 15 && next_mode == 1
        && next_low >= 10 && next_low <= 20000
        && next_high >= next_low + 1 && next_high <= min(20000, floor(srate * 0.49))
        && next_slope >= 0 && next_slope <= 3 && next_slope == floor(next_slope);
      desired_valid ? (
        desired_low = next_low;
        desired_high = next_high;
        desired_slope = next_slope;
      );
    );
    accepted_heartbeat = control_heartbeat;
  );
);

controller_alive = time_precise() - lease_time < LEASE_TIMEOUT;
// Recheck the device limit even while a configuration is being published.
should_filter = accepted_active >= 0.5 && gmem[1] >= 0.5
  && control_protocol == 15 && controller_alive && desired_valid
  && desired_high <= min(20000, floor(srate * 0.49));

should_filter && (!last_filtering || srate != last_srate) ? (
  active_scene = 0;
  configure_scene(active_scene, desired_low, desired_high, desired_slope);
  transition_phase = 0;
  warmup_position = 0;
  transition_position = 0;
  activation_position = 0;
) : should_filter && transition_phase == 1
    && !same_config(fade_to, desired_low, desired_high, desired_slope) ? (
  // The standby path is still silent, so a faster second choice can safely
  // replace it instead of making the listener wait through an obsolete band.
  start_transition(desired_low, desired_high, desired_slope);
) : should_filter && transition_phase == 0
    && !same_config(active_scene, desired_low, desired_high, desired_slope) ? (
  start_transition(desired_low, desired_high, desired_slope);
);

last_srate = srate;
last_filtering = should_filter;

filtering_now = should_filter;
activation_step = 1 / max(1, ACTIVATION_FADE_SECONDS * srate);
warmup_step = 1 / max(1, BAND_WARMUP_SECONDS * srate);
transition_step = 1 / max(1, CONFIG_FADE_SECONDS * srate);

// Report what this audio-processing instance actually accepted. The controller
// does not call the filter audible until every acknowledgement matches.
response_sequence += 1;
gmem[10] = response_sequence;
gmem[7] = accepted_heartbeat;
gmem[8] = filtering_now;
gmem[47] = srate;
response_sequence += 1;
gmem[10] = response_sequence;


stereo_final_requested = 0;
spectrum_revision = gmem[20];
spectrum_revision == floor(spectrum_revision) && spectrum_revision % 2 == 0 ? (
  spectrum_config_changed = spectrum_revision != spectrum_config_revision;
  requested_fft = floor(gmem[16] + 0.5);
  requested_fft != 2048 && requested_fft != 4096 && requested_fft != 8192 ? (
    requested_fft = DEFAULT_FFT_SIZE;
  );
  next_epoch = gmem[18];
  next_session = gmem[25];
  next_smoothing = gmem[17];
  next_capture_state = gmem[19];
  next_average_seconds = gmem[21];
  next_history_epoch = gmem[23];
  next_idle_seconds = gmem[24];
  next_stereo_enabled = gmem[22];
  next_analysis_channels = gmem[26];
  next_pair_left = gmem[27];
  next_pair_right = gmem[28];
  next_analysis_revision = gmem[29];
  outputs_valid = 1; outputs_changed = 0; next_max_output = 0; map_channel = 0;
  loop(MAX_CHANNELS,
    next_output = gmem[55 + map_channel];
    NEXT_OUTPUTS[map_channel] = next_output - 1;
    !(next_output == floor(next_output) && next_output >= 1 && next_output <= 128) ? outputs_valid = 0;
    map_channel < next_analysis_channels ? (
      next_max_output = max(next_max_output, next_output);
      OUTPUTS[map_channel] != next_output - 1 ? outputs_changed = 1;
      prior = 0; loop(map_channel, NEXT_OUTPUTS[prior] == next_output - 1 ? outputs_valid = 0; prior += 1;);
    );
    map_channel += 1;
  );
  valid_spectrum_config = outputs_valid && next_epoch == floor(next_epoch)
    && next_epoch >= 0 && next_epoch <= 1000000000
    && next_session == floor(next_session) && next_session > 0 && next_session <= 1000000000
    && next_capture_state == floor(next_capture_state)
    && next_capture_state >= 0 && next_capture_state <= 2
    && (next_average_seconds == 0 || next_average_seconds == 1
      || next_average_seconds == 3 || next_average_seconds == -1)
    && next_history_epoch == floor(next_history_epoch)
    && next_history_epoch >= 0 && next_history_epoch <= 1000000000
    && next_idle_seconds >= 0 && next_idle_seconds <= 1000000000
    && (next_stereo_enabled == 0 || next_stereo_enabled == 1)
    && next_analysis_channels == floor(next_analysis_channels)
    && next_analysis_channels >= 1 && next_analysis_channels <= MAX_CHANNELS
    && next_pair_left == floor(next_pair_left) && next_pair_left >= 1
    && next_pair_left <= next_analysis_channels
    && next_pair_right == floor(next_pair_right) && next_pair_right >= 1
    && next_pair_right <= next_analysis_channels
    && next_analysis_revision == floor(next_analysis_revision)
    && next_analysis_revision >= 0 && next_analysis_revision <= 1000000000;
  spectrum_revision == gmem[20] && valid_spectrum_config ? (
    fft_changed = requested_fft != FFT_SIZE;
    rate_changed = srate != spectrum_srate;
    fft_or_rate_changed = fft_changed || rate_changed;
    smoothing_changed = next_smoothing != smoothing_octaves;
    session_changed = next_session != spectrum_session;
    channel_layout_changed = outputs_changed || next_analysis_channels != analysis_channels
      || next_analysis_revision != analysis_revision;
    pair_changed = next_pair_left - 1 != pair_left || next_pair_right - 1 != pair_right;
    epoch_changed = next_epoch != spectrum_epoch || session_changed || channel_layout_changed;
    same_retiring_epoch = !epoch_changed;
    (epoch_changed || next_capture_state != 1) ? capture_authorized = 0;
    session_changed ? capture_session_pending = 1;
    heartbeat_changed ? capture_session_pending = 0;

    fft_or_rate_changed ? (
      configure_fft(requested_fft);
      // Display bands and calibration remain compatible across FFT sizes.
      // Preserve their history; a device-rate change still resets sample-based
      // ages and averages because their timing would otherwise be wrong.
      rate_changed ? reset_history();
    ) : epoch_changed ? reset_capture();
    history_changed = next_history_epoch != history_epoch || session_changed || channel_layout_changed;
    (smoothing_changed || history_changed) ? reset_history();
    next_average_seconds != average_seconds ? reset_average();
    (next_stereo_enabled != stereo_enabled || pair_changed) ? (
      stereo_packet_count = 0;
      stereo_last_clip_l = 0;
      stereo_last_clip_r = 0;
      stereo_last_clip_at = 0;
      stereo_last_clip_sample = 0;
    );

    final_requested = 0;
    next_capture_state == 1 && capture_state != 1 ? reset_capture();
    next_capture_state == 2 && capture_state == 1 && same_retiring_epoch ? (
      final_requested = 1;
      stereo_final_requested = 1;
      drain_active = 1;
